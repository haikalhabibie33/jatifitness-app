{
    "name": "codeigniter4/appstarter",
    "description": "CodeIgniter4 starter app",
    "license": "MIT",
    "type": "project",
    "homepage": "https://codeigniter.com",
    "support": {
        "forum": "https://forum.codeigniter.com/",
        "source": "https://github.com/codeigniter4/CodeIgniter4",
        "slack": "https://codeigniterchat.slack.com"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "opis/json-schema": "^2.6",
        "symfony/finder": "^8.0",
        "twbs/bootstrap": "5.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.16",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "migrate": ["@php spark migrate"],
        "migrate-clean": ["@php spark db:rebuild", "@php spark migrate"],
        "seed": ["@php spark db:seed DatabaseSeeder"],
        "rebuild": ["@php spark db:rebuild --purge --clean-history"],
        "rebuild:dry": ["@php spark db:rebuild --purge --clean-history --migrate=1 --seed=1 --dry=1"],
        "rebuild:keep": ["@php spark db:rebuild --keep-old --migrate=1 --seed=1"]
    }
}
